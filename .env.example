# Predloga za datoteko .env (docker compose). Kopirajte jo v ".env" in nastavite vrednosti:
#   cp .env.example .env
# Datoteka .env je v .gitignore in se ne shranjuje v repozitorij.

# Skrivnost za podpisovanje žetonov (obvezna). Ustvarite jo npr. z:  openssl rand -base64 48
JWT_SECRET=spremeni-me
JWT_EXPIRES_IN=8h

# PostgreSQL (storitev "db"). Geslo je obvezno in naj vsebuje samo črke in številke
# (uporablja se v povezovalnem nizu DATABASE_URL).
POSTGRES_DB=edulink
POSTGRES_USER=edulink
POSTGRES_PASSWORD=spremeni-me
# Vrata baze na tem računalniku (dostopna samo z 127.0.0.1, za lokalni razvoj)
POSTGRES_PORT=5433

# true = ob prvem zagonu napolni bazo s testnimi podatki (PB/insert.sql), false = prazna baza
SEED=true

# Vrata na računalniku: HTTPS (https://localhost:8443) in HTTP, ki preusmeri na HTTPS
HTTPS_PORT=8443
FRONTEND_PORT=8080

# Dodatna imena/naslovi v samopodpisanem certifikatu (da brskalnik ne javi napačnega imena), npr.
# CERT_SAN=DNS:edulink,DNS:edulink.local,IP:192.168.1.10
# Pravi certifikat (Let's Encrypt): glej docs/namestitev.md
# SSL_CERT=/etc/letsencrypt/live/domena.si/fullchain.pem
# SSL_KEY=/etc/letsencrypt/live/domena.si/privkey.pem
