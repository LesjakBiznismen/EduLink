{
  "name": "edulink-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EduLink – strežnik REST API (Node.js, Express, PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:reset": "node --env-file-if-exists=.env src/scripts/reset-db.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1"
  }
}
