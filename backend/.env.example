# Lokalni zagon backenda (npm run dev). Kopirajte v ".env" in nastavite vrednosti.

# Vrata, na katerih posluša strežnik
PORT=3000

# Povezava do PostgreSQL. Bazo zaženete z:  docker compose up -d db  (v korenu repozitorija)
# Uporabnik, geslo in ime baze morajo biti enaki kot POSTGRES_* v korenskem .env.
DATABASE_URL=postgres://edulink:spremeni-me@localhost:5433/edulink

# Mapa za naložena gradiva in oddaje
UPLOAD_DIR=./uploads

# Skrivnost za podpisovanje žetonov (obvezna; v produkciji uporabite dolg naključen niz)
JWT_SECRET=spremeni-me
JWT_EXPIRES_IN=8h

# true = ob ustvarjanju baze vstavi testne podatke, false = prazna baza
SEED=true
