# Vrata, na katerih posluša strežnik
PORT=3000

# Pot do SQLite baze; če datoteka ne obstaja, se ustvari iz PB/schema.sql in PB/insert.sql
DB_PATH=../PB/edulink.db

# Mapa za naložena gradiva in oddaje
UPLOAD_DIR=./uploads

# Skrivnost za podpisovanje žetonov (v produkciji obvezno spremenite)
JWT_SECRET=spremeni-me
JWT_EXPIRES_IN=8h
