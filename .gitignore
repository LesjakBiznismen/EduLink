# Skrivnosti in lokalna nastavitev
.env
.env.*
!.env.example
*.local

# Odvisnosti (obnovi jih `npm install`)
node_modules/

# Rezultati gradnje
dist/
dist-ssr/
build/
coverage/
.vite/

# Dnevniki
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Datoteke, ki jih naložijo učitelji in učenci (backend)
backend/uploads/

# Varnostne kopije baze in datotek (scripts/backup.sh) ter certifikati
backups/
certs/
*.pem
*.key
*.crt

# Stare lokalne SQLite baze (aplikacija zdaj uporablja PostgreSQL)
PB/*.db
PB/*.db-journal
PB/*.db-wal
PB/*.db-shm
PB/*.sqlite
PB/*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Orodja in urejevalniki
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# Operacijski sistem
.DS_Store
Thumbs.db
Desktop.ini
